{
  "datasets": [
    {
      "name": "ds_situacao_municipio",
      "displayName": "Distribuição por Situação da Meta",
      "queryLines": [
        "SELECT\n",
        "  situacao_meta,\n",
        "  COUNT(*) AS total\n",
        "FROM\n",
        "  workspace.gold.ft_meta_vs_resultado_municipio\n",
        "GROUP BY\n",
        "  situacao_meta\n",
        "ORDER BY\n",
        "  total DESC"
      ]
    },
    {
      "name": "ds_faixas",
      "displayName": "Distribuição por Faixa de Taxa",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN taxa_alfabetizacao < 50 THEN '0-50%'\n",
        "    WHEN taxa_alfabetizacao < 70 THEN '50-70%'\n",
        "    WHEN taxa_alfabetizacao < 90 THEN '70-90%'\n",
        "    ELSE '90-100%'\n",
        "  END AS faixa,\n",
        "  COUNT(*) AS total\n",
        "FROM\n",
        "  workspace.gold.ft_meta_vs_resultado_municipio\n",
        "WHERE\n",
        "  taxa_alfabetizacao IS NOT NULL\n",
        "GROUP BY\n",
        "  faixa\n",
        "ORDER BY\n",
        "  faixa"
      ]
    },
    {
      "name": "ds_scatter",
      "displayName": "Taxa vs Meta por Município",
      "queryLines": [
        "SELECT\n",
        "  taxa_alfabetizacao,\n",
        "  meta_alfabetizacao\n",
        "FROM\n",
        "  workspace.gold.ft_meta_vs_resultado_municipio\n",
        "WHERE\n",
        "  taxa_alfabetizacao IS NOT NULL\n",
        "  AND meta_alfabetizacao IS NOT NULL"
      ]
    },
    {
      "name": "ds_top_municipios",
      "displayName": "Top 20 Municípios",
      "queryLines": [
        "SELECT\n",
        "  id_municipio,\n",
        "  taxa_alfabetizacao,\n",
        "  meta_alfabetizacao,\n",
        "  situacao_meta\n",
        "FROM\n",
        "  workspace.gold.ft_meta_vs_resultado_municipio\n",
        "WHERE\n",
        "  taxa_alfabetizacao IS NOT NULL\n",
        "ORDER BY\n",
        "  taxa_alfabetizacao DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "ds_situacao_rede",
      "displayName": "Situação da Meta por Rede",
      "queryLines": [
        "SELECT\n",
        "  r.descricao_rede,\n",
        "  m.situacao_meta,\n",
        "  COUNT(*) AS total\n",
        "FROM\n",
        "  workspace.gold.ft_meta_vs_resultado_municipio m\n",
        "    JOIN workspace.gold.dim_rede r\n",
        "      ON m.rede_codigo = r.rede_codigo\n",
        "GROUP BY\n",
        "  r.descricao_rede,\n",
        "  m.situacao_meta\n",
        "ORDER BY\n",
        "  r.descricao_rede,\n",
        "  total DESC"
      ]
    },
    {
      "name": "ds_kpis",
      "displayName": "KPIs Nacionais",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT id_municipio) AS total_municipios,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN situacao_meta = 'ATINGIU_OU_SUPEROU' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS linhas_atingiram,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN situacao_meta IN ('ATINGIU_OU_SUPEROU', 'ABAIXO_DA_META') THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS linhas_comparaveis,\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN situacao_meta = 'ATINGIU_OU_SUPEROU' THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / NULLIF(\n",
        "        SUM(\n",
        "          CASE\n",
        "            WHEN situacao_meta IN ('ATINGIU_OU_SUPEROU', 'ABAIXO_DA_META') THEN 1\n",
        "            ELSE 0\n",
        "          END\n",
        "        ),\n",
        "        0\n",
        "      ),\n",
        "    1\n",
        "  ) AS pct_atingiu,\n",
        "  COUNT(DISTINCT\n",
        "    CASE\n",
        "      WHEN situacao_meta = 'ATINGIU_OU_SUPEROU' THEN id_municipio\n",
        "    END\n",
        "  ) AS municipios_atingiram,\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * COUNT(DISTINCT\n",
        "        CASE\n",
        "          WHEN situacao_meta = 'ATINGIU_OU_SUPEROU' THEN id_municipio\n",
        "        END\n",
        "      )\n",
        "      / NULLIF(\n",
        "        COUNT(DISTINCT\n",
        "          CASE\n",
        "            WHEN situacao_meta IN ('ATINGIU_OU_SUPEROU', 'ABAIXO_DA_META') THEN id_municipio\n",
        "          END\n",
        "        ),\n",
        "        0\n",
        "      ),\n",
        "    1\n",
        "  ) AS pct_atingiu_municipios,\n",
        "  ROUND(AVG(taxa_alfabetizacao), 1) AS taxa_media_simples_municipios\n",
        "FROM\n",
        "  workspace.gold.ft_meta_vs_resultado_municipio"
      ]
    },
    {
      "name": "ds_taxa_rede",
      "displayName": "Taxa por Rede de Ensino",
      "queryLines": [
        "SELECT\n",
        "  r.descricao_rede,\n",
        "  ROUND(AVG(f.taxa_alfabetizacao), 1) AS taxa_alfabetizacao\n",
        "FROM\n",
        "  workspace.gold.ft_resultado_uf f\n",
        "    JOIN workspace.gold.dim_rede r\n",
        "      ON f.rede_codigo = r.rede_codigo\n",
        "GROUP BY\n",
        "  r.descricao_rede\n",
        "ORDER BY\n",
        "  taxa_alfabetizacao DESC"
      ]
    },
    {
      "name": "ds_taxa_regiao",
      "displayName": "Taxa por Região",
      "queryLines": [
        "SELECT\n",
        "  u.regiao,\n",
        "  ROUND(AVG(f.taxa_alfabetizacao), 1) AS taxa_alfabetizacao\n",
        "FROM\n",
        "  workspace.gold.ft_resultado_uf f\n",
        "    JOIN workspace.gold.dim_uf u\n",
        "      ON f.sigla_uf = u.sigla_uf\n",
        "GROUP BY\n",
        "  u.regiao\n",
        "ORDER BY\n",
        "  taxa_alfabetizacao DESC"
      ]
    },
    {
      "name": "ds_bottom_municipios",
      "displayName": "Bottom 20 Municípios",
      "queryLines": [
        "SELECT\n",
        "  id_municipio,\n",
        "  taxa_alfabetizacao,\n",
        "  meta_alfabetizacao,\n",
        "  situacao_meta\n",
        "FROM\n",
        "  workspace.gold.ft_meta_vs_resultado_municipio\n",
        "WHERE\n",
        "  taxa_alfabetizacao IS NOT NULL\n",
        "ORDER BY\n",
        "  taxa_alfabetizacao ASC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "ds_taxa_uf",
      "displayName": "Taxa de Alfabetização por UF",
      "queryLines": [
        "SELECT\n",
        "  f.sigla_uf,\n",
        "  u.nome_uf,\n",
        "  u.regiao,\n",
        "  ROUND(AVG(f.taxa_alfabetizacao), 1) AS taxa_alfabetizacao\n",
        "FROM\n",
        "  workspace.gold.ft_resultado_uf f\n",
        "    JOIN workspace.gold.dim_uf u\n",
        "      ON f.sigla_uf = u.sigla_uf\n",
        "GROUP BY\n",
        "  f.sigla_uf,\n",
        "  u.nome_uf,\n",
        "  u.regiao\n",
        "ORDER BY\n",
        "  taxa_alfabetizacao DESC"
      ]
    }
  ],

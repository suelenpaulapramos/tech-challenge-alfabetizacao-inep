{
  "evaluation": {
    "source": {
      "name": "total_chaves_duplicadas"
    },
    "comparison_operator": "GREATER_THAN",
    "threshold": {
      "value": {
        "double_value": 0.0
      }
    },
    "notification": {
      "retrigger_seconds": 0,
      "notify_on_ok": true
    }
  },
  "schedule": {
    "quartz_cron_schedule": "0 0 * * * ?",
    "timezone_id": "America/Bahia"
  },
  "query_lines": [
    "SELECT COALESCE(SUM(failed_rows), 0) AS total_chaves_duplicadas",
    "FROM workspace.monitoring.qualidade_resultados",
    "WHERE rule_name = 'CHAVE_DUPLICADA'",
    "  AND status = 'FALHOU'",
    "  AND layer <> 'GOLD_DEMO'",
    "  AND checked_at >= (",
    "    SELECT MAX(checked_at)",
    "    FROM workspace.monitoring.qualidade_resultados",
    "    WHERE rule_name = 'CHAVE_DUPLICADA'",
    "      AND layer <> 'GOLD_DEMO'",
    "  )"
  ]
}

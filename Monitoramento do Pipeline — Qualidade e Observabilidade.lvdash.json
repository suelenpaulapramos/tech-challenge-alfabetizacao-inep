{
  "datasets": [
    {
      "name": "ds_execucoes_camada",
      "displayName": "Execuções por camada (7 dias)",
      "queryLines": [
        "SELECT\n",
        "  layer,\n",
        "  COUNT(*) AS num_execucoes,\n",
        "  SUM(row_count) AS total_registros\n",
        "FROM\n",
        "  workspace.monitoring.pipeline_runs\n",
        "WHERE\n",
        "  started_at >= DATE_SUB(CURRENT_DATE(), 7)\n",
        "GROUP BY\n",
        "  layer"
      ]
    },
    {
      "name": "ds_execucoes_7d",
      "displayName": "Resumo de execuções (7 dias)",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_execucoes,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN status = 'FALHA' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS total_falhas,\n",
        "  SUM(row_count) AS total_registros\n",
        "FROM\n",
        "  workspace.monitoring.pipeline_runs\n",
        "WHERE\n",
        "  started_at >= DATE_SUB(CURRENT_DATE(), 7)"
      ]
    },
    {
      "name": "ds_dq_resumo_7d",
      "displayName": "Resumo DQ (7 dias)",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_verificacoes,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN status = 'PASSOU' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS aprovadas,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN status = 'FALHOU' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS falhas\n",
        "FROM\n",
        "  workspace.monitoring.qualidade_resultados\n",
        "WHERE\n",
        "  checked_at >= DATE_SUB(CURRENT_DATE(), 7)"
      ]
    },
    {
      "name": "ds_timeline_7d",
      "displayName": "Timeline Execuções 7 dias",
      "queryLines": [
        "SELECT\n",
        "  DATE(started_at) AS data_execucao,\n",
        "  layer,\n",
        "  COUNT(*) AS num_execucoes,\n",
        "  SUM(row_count) AS total_registros\n",
        "FROM\n",
        "  workspace.monitoring.pipeline_runs\n",
        "WHERE\n",
        "  started_at >= DATE_SUB(CURRENT_DATE(), 7)\n",
        "GROUP BY\n",
        "  DATE(started_at),\n",
        "  layer\n",
        "ORDER BY\n",
        "  data_execucao,\n",
        "  layer"
      ]
    },
    {
      "name": "ds_dq_falhas",
      "displayName": "DQ Falhas por Regra (7d)",
      "queryLines": [
        "SELECT\n",
        "  rule_name,\n",
        "  severity,\n",
        "  SUM(failed_rows) AS total_registros_falha,\n",
        "  COUNT(*) AS num_falhas\n",
        "FROM\n",
        "  workspace.monitoring.qualidade_resultados\n",
        "WHERE\n",
        "  status = 'FALHOU'\n",
        "  AND checked_at >= DATE_SUB(CURRENT_DATE(), 7)\n",
        "GROUP BY\n",
        "  rule_name,\n",
        "  severity\n",
        "ORDER BY\n",
        "  total_registros_falha DESC"
      ]
    },
    {
      "name": "ds_ultimas_10",
      "displayName": "Últimas 10 Execuções",
      "queryLines": [
        "SELECT\n",
        "  run_id,\n",
        "  layer,\n",
        "  entity,\n",
        "  started_at,\n",
        "  finished_at,\n",
        "  ROUND(duration_seconds, 1) AS duracao_seg,\n",
        "  status,\n",
        "  row_count,\n",
        "  error_message\n",
        "FROM\n",
        "  workspace.monitoring.pipeline_runs\n",
        "ORDER BY\n",
        "  started_at DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "ds_dq_aprovacao_camada",
      "displayName": "Taxa de aprovação DQ por camada (7 dias)",
      "queryLines": [
        "SELECT\n",
        "  layer,\n",
        "  COUNT(*) AS total_verificacoes,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN status = 'PASSOU' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS aprovadas,\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN status = 'PASSOU' THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) AS taxa_aprovacao_pct\n",
        "FROM\n",
        "  workspace.monitoring.qualidade_resultados\n",
        "WHERE\n",
        "  checked_at >= DATE_SUB(CURRENT_DATE(), 7)\n",
        "GROUP BY\n",
        "  layer\n",
        "ORDER BY\n",
        "  layer"
      ]
    },
    {
      "name": "ds_dq_detalhes",
      "displayName": "Verificações DQ recentes",
      "queryLines": [
        "SELECT\n",
        "  execution_id,\n",
        "  layer,\n",
        "  table_name,\n",
        "  rule_name,\n",
        "  severity,\n",
        "  checked_at,\n",
        "  failed_rows,\n",
        "  status,\n",
        "  details\n",
        "FROM\n",
        "  workspace.monitoring.qualidade_resultados\n",
        "ORDER BY\n",
        "  checked_at DESC\n",
        "LIMIT 20"
      ]
    }
  ],

{
  "evaluation": {
    "source": {
      "name": "falhas_recentes"
    },
    "comparison_operator": "GREATER_THAN",
    "threshold": {
      "value": {
        "double_value": 0.0
      }
    },
    "notification": {
      "retrigger_seconds": 0,
      "notify_on_ok": true
    }
  },
  "schedule": {
    "quartz_cron_schedule": "0 0 * * * ?",
    "timezone_id": "America/Bahia"
  },
  "query_lines": [
    "SELECT COUNT(*) AS falhas_recentes",
    "FROM workspace.monitoring.pipeline_runs",
    "WHERE status != 'SUCESSO'",
    "  AND started_at >= DATE_SUB(CURRENT_DATE(), 1)"
  ]
}
